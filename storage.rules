rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función helper para verificar autenticación de administrador (no anónimo)
    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Regla general para todos los archivos (imágenes de noticias, logos, etc)
    // Lectura: Pública (los usuarios deben poder ver las imágenes de las noticias)
    // Escritura: Solo administradores autenticados
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
