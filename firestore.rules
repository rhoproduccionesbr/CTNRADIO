rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función helper para verificar si el usuario es administrador autenticado (no anónimo)
    function isAdmin() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Colección: configuracion (URL del stream, etc)
    // Lectura: Pública (para que cualquier visitante escuche la radio)
    // Escritura: Solo administradores autenticados
    match /configuracion/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Colección: noticias
    // Lectura: Pública (cualquiera puede ver las noticias)
    // Escritura (Crear, Actualizar, Borrar): Solo administradores autenticados
    match /noticias/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Colección: programacion (Grilla horaria)
    // Lectura: Pública
    // Escritura: Solo administradores autenticados
    match /programacion/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Colección: galeria (Fotos para el reproductor)
    // Lectura: Pública
    // Escritura: Solo administradores autenticados
    match /galeria/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
